---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout>
  <!-- Hero / Introduction -->
  <section class="intro-section" style="margin-bottom: 2rem;">
    <h1 style="font-size: 2.1rem; margin-bottom: 0.5rem; letter-spacing: -0.01em;">
      {SITE.author}
    </h1>
    <p style="font-size: 1.05rem; color: var(--text-color); margin-bottom: 1rem; line-height: 1.5;">
      {SITE.headline}
    </p>
    <div style="font-size: 0.95rem; display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <span>·</span>
      <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <span>·</span>
      <a href={`mailto:${SITE.email}`}>Email</a>
    </div>
  </section>

  <hr />

  <!-- About -->
  <section class="about-section">
    <h2>About</h2>
    <p>
      I am a fourth-year Computer Science and Engineering undergraduate at 
      <strong>Vellore Institute of Technology, Bhopal</strong>. My academic interests lie at the intersection of 
      machine learning systems, natural language processing, and recommendation systems.
    </p>
    <p>
      Recently, I was a Research Intern at the <strong>Indian Institute of Technology, Delhi</strong> (MISN Lab, Project AdiVaani), 
      where I worked on parameter-efficient fine-tuning (PEFT/LoRA) and model adaptation of multilingual models (NLLB-200, Qwen, Llama) 
      for low-resource Indian tribal languages.
    </p>
    <p>
      Outside of coursework and research, I enjoy reading technical papers, building practical developer utilities, and writing notes about things I learn.
    </p>
  </section>

  <hr />

  <!-- Technical Interests -->
<section class="interests-section">
  <h2>Technical Interests</h2>
  <ul>
    <li><strong>Natural Language Processing:</strong> Low-resource neural machine translation, multilingual representation learning.</li>
    <li><strong>Parameter-Efficient Fine-Tuning:</strong> LoRA, Mixture-of-LoRA (MoA) adaptation architectures, quantization.</li>
    <li><strong>Machine Learning & Analytics:</strong> Predictive modeling, statistical analysis, model evaluation, and data-driven insights.</li>
    <li><strong>Information Retrieval & Recommendation:</strong> Vector embeddings, semantic similarity search with pgvector, RAG, and recommendation systems.</li>
  </ul>
</section>

  <hr />

  <!-- Selected Projects -->
  <section class="projects-section">
    <h2>Selected Projects</h2>

    <div class="item-entry">
      <div class="item-header">
        <a href="https://github.com/mkdir-smyk/paperly" target="_blank" rel="noopener noreferrer" class="item-title">
          Paperly: Semantic News Recommendation Engine
        </a>
        <a href="https://github.com/mkdir-smyk/paperly" target="_blank" rel="noopener noreferrer" class="item-meta">GitHub →</a>
      </div>
      <p class="tech-stack">Python, FastAPI, PyTorch (SentenceTransformers), PostgreSQL (pgvector), Docker</p>
      <p class="item-desc">
        A real-time news aggregation and recommendation system. Uses dense 384-dimensional embeddings and direct database-level cosine distance queries via pgvector to solve the cold-start problem.
      </p>
    </div>

    <div class="item-entry">
      <div class="item-header">
        <a href="https://github.com/mkdir-smyk/VisionMark" target="_blank" rel="noopener noreferrer" class="item-title">
          VisionMark: Intelligent Document-to-Markdown Pipeline
        </a>
        <a href="https://github.com/mkdir-smyk/VisionMark" target="_blank" rel="noopener noreferrer" class="item-meta">GitHub →</a>
      </div>
      <p class="tech-stack">Python, Qwen2.5-VL, Hugging Face, FastAPI</p>
      <p class="item-desc">
        A document ingestion engine converting PDFs, Office docs, and images into structured Markdown. Integrates vision-language models for accurate layout preservation, table extraction, and OCR.
      </p>
    </div>

    <div class="item-entry">
      <div class="item-header">
        <a href="https://github.com/mkdir-smyk/audio-ingestion-preprocessing-pipeline" target="_blank" rel="noopener noreferrer" class="item-title">
          Automated Audio Ingestion & Preprocessing Pipeline
        </a>
        <a href="https://github.com/mkdir-smyk/audio-ingestion-preprocessing-pipeline" target="_blank" rel="noopener noreferrer" class="item-meta">GitHub →</a>
      </div>
      <p class="tech-stack">Python, PyTorch, FFmpeg, Silero VAD, Docker</p>
      <p class="item-desc">
        An automated pipeline preparing speech corpora for model training. Standardizes heterogeneous audio into 16kHz WAV and trims silence using Silero VAD, cutting storage footprint by ~30%.
      </p>
    </div>
  </section>
</BaseLayout>
