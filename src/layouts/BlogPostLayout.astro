---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Calculate reading time based on 200 words per minute
const wordCount = post.body.trim().split(/\s+/).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={title} description={description} ogType="article">
  <article class="blog-post">
    <div style="margin-bottom: 0.75rem;">
      <a href={`${baseUrl}/blog`} style="font-size: 0.88rem; color: var(--text-muted); text-decoration: none;">← Back to all posts</a>
    </div>

    <header style="margin-bottom: 1.75rem;">
      <h1 style="margin-bottom: 0.5rem; font-size: 2rem;">{title}</h1>
      <div style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.6rem;">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span> · </span>
        <span>{readingMinutes} min read</span>
      </div>
      {tags && tags.length > 0 && (
        <div class="tag-list" style="margin-top: 0.5rem;">
          {tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <hr />

    <div class="article-content">
      <slot />
    </div>

    <hr style="margin-top: 3rem;" />
    
    <div style="margin-top: 1.5rem; font-size: 0.9rem;">
      <a href={`${baseUrl}/blog`}>← Back to Blog</a>
    </div>
  </article>
</BaseLayout>
