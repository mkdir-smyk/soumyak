---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  showTags?: boolean;
}

const { post, showTags = true } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const postHref = `${baseUrl}/blog/${post.slug}`;

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="item-entry">
  <div class="item-header">
    <a href={postHref} class="item-title">{post.data.title}</a>
    <time datetime={post.data.pubDate.toISOString()} class="item-meta">{formattedDate}</time>
  </div>
  <p class="item-desc">{post.data.description}</p>
  {showTags && post.data.tags && post.data.tags.length > 0 && (
    <div class="tag-list">
      {post.data.tags.map((tag: string) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</article>
